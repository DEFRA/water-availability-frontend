{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "water-availability-frontend"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">
        Backend composes integration status, including aggregator reachability.
      </p>

      <h2 class="govuk-heading-m">Backend-composed status</h2>
      <p class="govuk-body"><strong>URL:</strong> {{ backend.url }}</p>
      <p class="govuk-body"><strong>HTTP status:</strong> {{ backend.statusCode or 'n/a' }}</p>
      <pre class="govuk-body" data-testid="backend-status">{{ backendJson }}</pre>
    </div>
  </div>
{% endblock %}